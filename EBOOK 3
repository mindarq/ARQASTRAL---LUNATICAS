          <button class="choice-btn" onclick="selectChoice(this,'q5_2','mantra')">Repetir el mantra de mi herida principal por 21 días</button>
          <button class="choice-btn" onclick="selectChoice(this,'q5_2','diario')">Llevar mi diario emocional honesto y sin juicio</button>
