    <div class="final-aff">"Este es un trabajo de por vida. Poco a poco, sin prisa. Cada pequeño paso cuenta."</div>
    <p style="text-align:center;font-size:11px;color:rgba(255,255,255,.18);letter-spacing:4px;text-transform:uppercase;margin-top:20px;">✦ Sanarte · Tu espacio de sanación</p>
  </div>
</div>

<div class="nav">
  <button class="nav-btn" id="prevBtn" onclick="changePage(-1)" disabled>‹</button>
  <span class="nav-pages" id="navPages">1 / 5</span>
  <button class="nav-btn" id="nextBtn" onclick="changePage(1)">›</button>
</div>

<script>
const totalPages=5; let current=1; const saved={};
const feedbacks={
  q2_2:{
    'lista buenas':'Perfecto. La lista de las 3 cosas buenas activa gradualmente el circuito de la gratitud en el cerebro. Ponéla en el celular como recordatorio a la noche.',
    opinion:'Dar tu opinión cuando la herida de rechazo está activa requiere un coraje enorme. Empezá por opiniones pequeñas y de bajo riesgo. La voz se va fortaleciendo.',
    capacidades:'Nombrarlo en voz alta es mucho más poderoso que pensarlo. Escucharte decirlo cambia la experiencia. Hacélo aunque al principio suene falso.',
    social:'Conectar con alguien nuevo desafía directamente la tendencia huidiza. No tiene que ser algo grande: una conversación, un mensaje, una sonrisa genuina.'
  },
  q3_1:{
    abandono:'El abandono es quizás la herida más dolorosa porque toca la base de la supervivencia. El trabajo más importante: aprender a estar con vos misma sin que eso sea una amenaza existencial.',
    humillacion:'La humillación es una herida muy corporal. Se guarda en la postura, en el peso, en la tensión crónica. Trabajar desde el cuerpo hacia adentro (movimiento, respiración) es muy efectivo.',
    'ambas igual':'Que las dos estén activas con la misma intensidad indica que el trabajo interior es profundo y necesario. No intentes hacer todo a la vez: elegí una práctica de cada una y alternálas.'
  },
  q4_1:{
    '1':'Vivir sin poder confiar es agotador. Es llevar una armadura pesada todos los días. El trabajo no es decidir "voy a confiar más" sino ir sanando las experiencias de traición que generaron esa armadura.',
    '2':'Hay herida de traición activa. La hipervigilancia que genera el nivel 2 es costosa en energía. Preguntate: ¿quién en mi vida actual ha demostrado ser confiable aunque yo no lo registre plenamente?',
    '3':'Un nivel sano de selectividad. El trabajo es expandir gradualmente ese círculo de confianza y notar las evidencias de que no todos van a traicionarte.',
    '4':'Estás en un buen lugar. El "me cuido" ya no tiene que ser una coraza sino una simple consciencia. Seguí practicando la apertura gradual.',
    '5':'Qué hermoso poder confiar así. Esa capacidad es un logro enorme si venís de una herida de traición. Cuidá seguir eligiendo personas que merezcan esa confianza.'
  },
  q5_2:{
    espejo:'El espejo es el ejercicio más simple y más transformador. 5 minutos al día. Mirarte a los ojos. Decirte algo real y amoroso. El cerebro tarda pero aprende.',
    mantra:'21 días de consistencia generan nuevos surcos neuronales. Ponélo en el despertador, en un post-it en el baño, en la nota del teléfono. Rodéate del mantra.',
    diario:'El diario honesto es un espejo sin distorsión. Escribí sin censura. Lo que sale al papel ya no tiene el mismo poder adentro tuyo.',
    cuerpo:'El cuerpo guarda la herida. Moverlo la libera. No necesita ser ejercicio intenso: bailar sola en tu cuarto 10 minutos es profundamente sanador.'
  }
};
function selectChoice(btn,qId,value){
  document.querySelectorAll(`#${qId} .choice-btn`).forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
  autoSave(qId,value);
  if(feedbacks[qId]&&feedbacks[qId][value]){
    const box=document.getElementById(`fb_${qId}`);
    document.getElementById(`fb_${qId}_text`).textContent=feedbacks[qId][value];
    if(box)box.classList.add('show');
  }
}
function autoSave(k,v){saved[k]=v;}
function saveAll(btn){btn.textContent='✦ ¡Compromiso guardado!';btn.classList.add('saved');setTimeout(()=>{btn.textContent='✦ Guardar mi compromiso de sanación';btn.classList.remove('saved');},3000);}
function changePage(dir){
  const next=current+dir;
  if(next<1||next>totalPages)return;
  document.getElementById(`p${current}`).classList.remove('active');
  current=next;
  document.getElementById(`p${current}`).classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  updateNav();
}
function updateNav(){
  document.getElementById('navPages').textContent=`${current} / ${totalPages}`;
  document.getElementById('prevBtn').disabled=current===1;
  document.getElementById('nextBtn').disabled=current===totalPages;
  document.getElementById('progressBar').style.width=((current-1)/(totalPages-1)*100)+'%';
}
updateNav();
</script>
</body>
</html>
